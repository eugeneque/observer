# Адрес сервиса (run.py, windows\start.bat, linux/run.sh)
HOST=0.0.0.0
PORT=8010
# Префикс за обратным прокси (например /observer/observer-main). Пусто — сервис открыт в корне.
ROOT_PATH=

# Токен для 1С (заголовок X-API-Key). Пусто — без проверки.
API_TOKEN=
CACHE_HOURS=24
HEADLESS=true

RUSPROFILE_ENABLED=true
RUSPROFILE_LOGIN=
RUSPROFILE_PASSWORD=

GLOBAS_ENABLED=true
GLOBAS_URL=https://globas.credinform.ru
GLOBAS_LOGIN=
GLOBAS_PASSWORD=
GLOBAS_SEARCH_PATH=/search/rezultaty-poiska?query={inn}
# Если автоматический поиск кнопки выгрузки не сработает — селекторы кликов через «;»
GLOBAS_EXPORT_STEPS=

# gigachat | anthropic | routerai:<модель> | auto
AI_PROVIDER=auto

GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_CORP
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_CA_BUNDLE=
GIGACHAT_VERIFY_SSL=true
GIGACHAT_SEND_FILES=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# RouterAI (routerai.ru): один ключ — все модели из списка появятся в интерфейсе
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_MODELS=qwen/qwen3.8-27b,deepseek/deepseek-v4-pro-0813
